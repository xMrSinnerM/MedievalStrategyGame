; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Medieval Strategy"
config/description="Medieval strategy game prototype: campaign world map and castle economy."
config/use_custom_user_dir=true
config/custom_user_dir_name="MedievalStrategy"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameData="*res://scripts/core/game_data.gd"
Economy="*res://scripts/core/economy.gd"
Settings="*res://scripts/core/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
